VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
# Админы (через запятую). Если пусто — d.pishalkin@gmail.com
VITE_ADMIN_EMAILS=d.pishalkin@gmail.com

# ── Telegram Bot (Supabase Edge Function secrets, не нужны в .env фронта) ──
# Добавить через: supabase secrets set TELEGRAM_BOT_TOKEN=...
# TELEGRAM_BOT_TOKEN=123456789:AABBCCDDeeff...   # токен бота от @BotFather
# TELEGRAM_CHAT_ID=-100123456789                  # опционально: fallback-чат для команды GrowControl
# Имя бота для deep link и инструкций в UI:
VITE_TELEGRAM_BOT_USERNAME=controlgrow_bot
